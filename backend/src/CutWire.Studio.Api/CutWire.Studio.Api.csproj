<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <EmbedSpa Condition="'$(EmbedSpa)' == '' and '$(Configuration)' == 'Release'">true</EmbedSpa>
    <SpaDist>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', 'web', 'dist'))</SpaDist>
    <GenerateEmbeddedFilesManifest Condition="'$(EmbedSpa)' == 'true'">true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(EmbedSpa)' == 'true'">
    <EmbeddedResource Include="$(SpaDist)**" Exclude="$(SpaDist)**/*.map" LinkBase="spa" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CutWire.Studio.Infrastructure\CutWire.Studio.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CutWire.Studio.UnitTests" />
  </ItemGroup>
</Project>
