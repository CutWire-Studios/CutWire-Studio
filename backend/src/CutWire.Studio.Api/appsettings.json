{
  "PublicUrl": "http://localhost:8087",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=studio;Username=studio;Password=studio"
  },
  "Storage": {
    "BlobRoot": "data/blobs"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Jobs": {
    "Enabled": true
  },
  "BlobGc": {
    "Retention": "7.00:00:00",
    "Interval": "01:00:00"
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "Window": "00:01:00"
  },
  "Spa": {
    "Root": null
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
