@page
@model UsersModel
@{
    ViewData["Title"] = "Users";
    void Keep()
    {
        <input type="hidden" name="q" value="@Model.Q">
        <input type="hidden" name="cursor" value="@Model.Cursor">
    }
}
<h1>Users</h1>

<form method="get" class="toolbar">
    <input type="search" name="q" value="@Model.Q" placeholder="Handle or display name" class="wide">
    <button type="submit">Search</button>
</form>

<div class="scroll"><table>
    <thead><tr><th>Handle</th><th>Roles</th><th>Trust</th><th>State</th><th>Joined</th><th class="center">Items</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var user in Model.Data.Users)
    {
        <tr>
            <td>@user.Handle<div class="meta">@user.DisplayName</div></td>
            <td>@foreach (var role in user.Roles) { <span class="badge">@role</span> }</td>
            <td><span class="badge">@user.TrustLevel</span></td>
            <td>
                @if (user.PermanentlyBanned) { <span class="badge danger">banned permanently</span> }
                else if (user.Banned) { <span class="badge danger">banned until @user.BannedUntil?.UtcDateTime.ToString("u")</span> }
                @if (!user.EmailVerified) { <span class="badge">unverified</span> }
            </td>
            <td>@user.JoinedAt.UtcDateTime.ToString("yyyy-MM-dd")</td>
            <td class="center">@user.ItemCount</td>
            <td>
                <details>
                    <summary>Manage</summary>
                    <form method="post" asp-page-handler="Trust" class="inline">
                        @{ Keep(); }
                        <input type="hidden" name="id" value="@user.Id">
                        <select name="level">
                            @foreach (var level in new[] { "T0", "T1", "T2", "T3" })
                            {
                                <option value="@level" selected="@(level == user.TrustLevel)">@level</option>
                            }
                        </select>
                        <input type="text" name="reason" placeholder="Reason">
                        <button type="submit">Set trust</button>
                    </form>
                    @if (user.Banned)
                    {
                        <br>
                        <form method="post" asp-page-handler="Unban" class="inline">
                            @{ Keep(); }
                            <input type="hidden" name="id" value="@user.Id">
                            <input type="text" name="reason" placeholder="Reason">
                            <button type="submit">Unban</button>
                        </form>
                    }
                    else
                    {
                        <br>
                        <form method="post" asp-page-handler="Ban" class="inline">
                            @{ Keep(); }
                            <input type="hidden" name="id" value="@user.Id">
                            <input type="date" name="until" aria-label="Ban until">
                            <label class="check"><input type="checkbox" name="permanent" value="true"> Permanent</label>
                            <input type="text" name="reason" placeholder="Reason (required)" required>
                            <button type="submit" class="danger">Ban</button>
                        </form>
                    }
                </details>
            </td>
        </tr>
    }
    </tbody>
</table></div>

@if (Model.Data.Users.Count == 0)
{
    <p class="note">No users found.</p>
}

@if (Model.Data.NextCursor is { } next)
{
    <div class="pager"><a href="/admin/users?q=@Uri.EscapeDataString(Model.Q ?? "")&cursor=@next">Next page</a></div>
}
