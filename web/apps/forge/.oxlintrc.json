{
  "plugins": [
    "typescript",
    "react",
    "import",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist",
    "public",
    "src/**/wasm/drift-audio.mjs",
    "src/**/wasm/drift-audio.d.mts"
  ],
  "rules": {
    "no-nested-ternary": "error",
    "complexity": [
      "error",
      {
        "max": 15
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 400,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 150,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-explicit-any": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^@/features/[a-z-]+/.+",
            "message": "Import another feature through its index: @/features/<slice>."
          }
        ]
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/services/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(features|state|shared/ui|app)(/|$)",
                "message": "services sit below the UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/state/**",
        "src/shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(features|app)(/|$)",
                "message": "state and shared UI sit below features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/services/audio-preview/AudioPreview.ts"
      ],
      "rules": {
        "import/default": "off"
      }
    },
    {
      "files": [
        "src/__tests__/**",
        "scripts/**"
      ],
      "rules": {
        "max-lines-per-function": "off",
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
